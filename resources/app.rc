#include <winres.h>
#include "resource.h"

// Application icon
IDI_APP             ICON            "icon.ico"

// Application manifest (RT_MANIFEST = 24, resource id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID)
1                   24              "app.manifest"

// Version info
VS_VERSION_INFO     VERSIONINFO
    FILEVERSION     3,0,0,0
    PRODUCTVERSION  3,0,0,0
    FILEFLAGSMASK   0x3FL
    FILEFLAGS       0x0L
    FILEOS          0x40004L
    FILETYPE        0x1L
    FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Zutfen LLC"
            VALUE "FileDescription",  "Mouse Jiggler Neo"
            VALUE "FileVersion",      "3.0.0.0"
            VALUE "InternalName",     "mouse-jiggler-neo"
            VALUE "OriginalFilename", "mouse-jiggler-neo.exe"
            VALUE "ProductName",      "Mouse Jiggler Neo"
            VALUE "ProductVersion",   "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

//------------------------------------------------------------------------------
// Main dialog
//
// Layout (dialog units):
//   Always-visible top row:  "Jiggling?" checkbox, "Settings..." toggle,
//                            "Minimize to tray" + "About" buttons.
//   Settings panel (toggled via SETTINGS): mode, period, distance,
//                                          random, minimize-on-startup,
//                                          daily local-time auto-stop.
//------------------------------------------------------------------------------

IDD_MAIN DIALOGEX 0, 0, 220, 195
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_SYSMENU | WS_CAPTION | WS_POPUP | WS_VISIBLE
CAPTION "Mouse Jiggler Neo"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "&Jiggling?",         IDC_JIGGLING,        10,  10,  60, 12
    AUTOCHECKBOX    "&Settings...",       IDC_SETTINGS,        80,  10,  60, 12, BS_PUSHLIKE
    PUSHBUTTON      "&Minimize to tray",  IDC_BTN_TRAYIFY,    150,  10,  60, 12
    PUSHBUTTON      "&About",             IDC_BTN_ABOUT,      150,  26,  60, 12

    // ---- Settings panel (initially hidden; toggled by IDC_SETTINGS) ----
    GROUPBOX        "Settings",           IDC_PANEL_SETTINGS,  10,  45, 200, 140

    LTEXT           "Mode:",              IDC_LBL_MODE,        18,  60,  40,  9
    COMBOBOX                              IDC_CMB_MODE,        65,  58, 140, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Interval (s):",      IDC_LBL_PERIOD,      18,  78,  45,  9
    EDITTEXT                              IDC_NUD_PERIOD,      65,  76,  50, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "60 s",               IDC_LBL_PERIOD_DISPLAY,
                                                              125,  78,  40,  9

    LTEXT           "Distance:",          IDC_LBL_DISTANCE,    18,  96,  45,  9
    EDITTEXT                              IDC_NUD_DISTANCE,    65,  94,  50, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP

    AUTOCHECKBOX    "&Random timer variation",
                                          IDC_CB_RANDOM,       18, 114, 180, 10
    AUTOCHECKBOX    "Minimize on start&up",
                                          IDC_CB_MINIMIZE,     18, 128, 180, 10
    AUTOCHECKBOX    "Auto stop at:",
                                          IDC_CB_AUTO_STOP,    18, 144, 64, 10
    EDITTEXT                              IDC_NUD_STOP_HOUR,   88, 142, 20, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           ":",                  IDC_LBL_STOP_COLON, 110, 144,  6,  9
    EDITTEXT                              IDC_NUD_STOP_MINUTE, 116, 142, 20, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    COMBOBOX                              IDC_CMB_STOP_AMPM,   142, 140, 50, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

//------------------------------------------------------------------------------
// About dialog
//------------------------------------------------------------------------------

IDD_ABOUT DIALOGEX 0, 0, 220, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Mouse Jiggler Neo"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP,              -1,                  10,  10,  20, 20
    LTEXT           "Mouse Jiggler Neo", IDC_LBL_APPNAME,   40,  10, 170,  9
    LTEXT           "Version 3.0.0",      IDC_LBL_VERSION,     40,  22, 170,  9
    LTEXT           "Copyright \xa9 Eric Sutphen 2026.",
                                          IDC_LBL_COPYRIGHT,   10,  40, 200, 20
    LTEXT           "A utility to continuously jiggle the mouse pointer to prevent screen saver activation.",
                                          IDC_LBL_DESCRIPTION, 10,  62, 200, 20
    CONTROL         "<a href=""https://github.com/Zutfen-LLC/mouse-jiggler-neo"">Project page</a>",
                                          IDC_LNK_URL, "SysLink", WS_TABSTOP,
                                                              10,  85, 200, 10
    DEFPUSHBUTTON   "OK",                 IDOK,               165,  85,  45, 14
END
